# Release zips (build/publish.ps1)
dist/

# The player's own title font goes in Fonts beside the editor; only its note is ours. A font file left in the
# source folder (AvQest, say) is never committed: the editor ships none but Cinzel.
src/PD2SPCompanion.Shell.Desktop/Fonts/*
!src/PD2SPCompanion.Shell.Desktop/Fonts/README.txt
