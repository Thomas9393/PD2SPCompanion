<?xml version="1.0" encoding="utf-8"?>
<!--
  The editor as it is handed out:  dotnet publish src/PD2SPCompanion.Shell.Desktop -p:PublishProfile=win-x64
  Precompiled (ReadyToRun): the code each page builds with is compiled ahead, not on its first use.
  Measured with tests/perf against the same Release build without it: load 440 -> 307 ms,
  first Items page 370 -> 230 ms, first item 186 -> 144 ms of frozen UI; 23 MB larger.
  Self-contained: the .NET runtime is in the folder, so a player installs nothing - the editor is
  one folder, deleted to uninstall.
  Single file: the program and the runtime in PD2SPCompanion.exe, so the folder reads as an app and not as
  three hundred files. The native libraries (graphics, text, the trade cache's database) stay beside
  it rather than unpacking themselves into %TEMP% at every start. No symbol files: a crash log names
  the methods but not the lines.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <PublishDir>bin\Publish\win-x64\</PublishDir>
  </PropertyGroup>

  <!-- CopyOutputSymbolsToPublishDirectory covers the editor's own symbols only; the referenced
       projects' and the native libraries' (Skia's alone is 84 MB) come along unless taken out. -->
  <Target Name="NoSymbolsInPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'"/>
    </ItemGroup>
  </Target>
</Project>
