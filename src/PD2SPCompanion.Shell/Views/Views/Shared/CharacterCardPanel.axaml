<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:views="using:PD2SPCompanion.Shell.Views"
			 xmlns:base="using:PD2SPCompanion.Shell.CustomControls.Base"
             mc:Ignorable="d" d:DesignWidth="560" d:DesignHeight="300"
             x:Class="PD2SPCompanion.Shell.Views.CharacterCardPanel"
             x:Name="Root"
             x:DataType="views:CharacterCardPanel">

	<!-- A character, as the Character page shows the open one: the figure, the name, what it is, its
	     badges, life, mana and stamina, when it was played - and under a rule, a row the page gives it
	     (the Character page its level and experience steppers). The Experimental page's Armory Import
	     shows a fetched character with it (the same character card). Everything
	     is set by the page through the properties; nothing here reads a view model. -->
	<UserControl.Styles>
		<StyleInclude Source="/Styles/CommonControls/Badge.axaml"/>
		<StyleInclude Source="/Styles/CommonControls/PageText.axaml"/>

	</UserControl.Styles>

	<!-- A thin gold frame (it was 2). -->
	<Border BorderBrush="{DynamicResource [UI] GradBrush - Frame - Golden#02}"
			BorderThickness="1" CornerRadius="3"
			Background="Black">
		<!-- The top row as tall as the details need, not more (lower); the figure
		     scales to it. -->
		<Grid RowDefinitions="172,Auto" Margin="16,10">
			<!-- Proportional rather than Auto: the figure column was sized by the art, so a
			     wider panel left the details hugging it with the gained space all to the
			     right. Both now share the width. -->
			<Grid Grid.Row="0" ColumnDefinitions="*,2*">
				<!-- The character in its gear once it is drawn; the class picture until then, or where it
				     cannot be (an armory card). -->
				<Panel Grid.Column="0" Margin="0,0,18,0">
					<base:FigureImage Figure="{Binding #Root.Card.BareFigure}"
							IsVisible="{Binding #Root.Card.ShowsClassPicture}"/>
					<base:FigureImage AutomationProperties.Name="Character figure" Figure="{Binding #Root.Card.Figure}"
							IsVisible="{Binding #Root.Card.HasFigure}"/>
				</Panel>

				<StackPanel Grid.Column="1" VerticalAlignment="Center">
					<TextBlock base:TrimmedTip.Tip="{Binding #Root.Card.Name}" Text="{Binding #Root.Card.Name}"
							   FontFamily="{StaticResource DiabloFont}"
							   FontSize="{StaticResource [Type] Display}" FontWeight="Bold"
							   Foreground="{DynamicResource [Text] Heading}"
							   TextTrimming="CharacterEllipsis"
							   Effect="drop-shadow(0 0 10 Black)"/>
					<TextBlock Text="{Binding #Root.Description}"
							   Foreground="{DynamicResource [Text] Body}" FontSize="{StaticResource [Type] Body}" Margin="0,3,0,0"
							   TextWrapping="Wrap"/>

					<StackPanel Orientation="Horizontal" Spacing="5" Margin="0,6,0,0">
						<Border Classes="badge" BorderBrush="{Binding #Root.Card.ModeBrush}">
							<TextBlock Text="{Binding #Root.Card.Mode}"
									   Foreground="{Binding #Root.Card.ModeBrush}"/>
						</Border>
						<Border Classes="badge"
								BorderBrush="{DynamicResource [Text] Body}">
							<TextBlock Text="{Binding #Root.Card.Ruleset}"
									   Foreground="{DynamicResource [Text] Body}"/>
						</Border>
						<Border Classes="badge" IsVisible="{Binding #Root.Card.IsDead, FallbackValue=False}"
								BorderBrush="{DynamicResource [Brush] Rarity - Broken items}">
							<TextBlock Text="{L 'DEAD'}"
									   Foreground="{DynamicResource [Text] Danger}"/>
						</Border>
					</StackPanel>

					<!-- Life, mana and stamina as the save stores them: before gear, which adds its
					     own and is not counted here. -->
					<StackPanel Orientation="Horizontal" Spacing="14" Margin="0,8,0,0"
								Background="Transparent" HorizontalAlignment="Left"
								ToolTip.Tip="{L 'Base values, without gear'}">
						<TextBlock FontSize="{StaticResource [Type] Body}">
							<Run Text="{L 'Life'}" Foreground="{DynamicResource [Text] Body}"/><Run Text=" "/>
							<Run Text="{Binding #Root.Life}" Foreground="{DynamicResource [Brush] Rarity - Broken items}"/>
						</TextBlock>
						<TextBlock FontSize="{StaticResource [Type] Body}">
							<Run Text="{L 'Mana'}" Foreground="{DynamicResource [Text] Body}"/><Run Text=" "/>
							<Run Text="{Binding #Root.Mana}" Foreground="{DynamicResource [Brush] Rarity - Magic items}"/>
						</TextBlock>
						<TextBlock FontSize="{StaticResource [Type] Body}">
							<Run Text="{L 'Stamina'}" Foreground="{DynamicResource [Text] Body}"/><Run Text=" "/>
							<Run Text="{Binding #Root.Stamina}" Foreground="{DynamicResource [Brush] Rarity - Rare items}"/>
						</TextBlock>
					</StackPanel>

					<TextBlock Text="{Binding #Root.Card.LastSaved}" Classes="dim" Margin="0,8,0,0"/>
					<TextBlock Text="{Binding #Root.Card.CreatedOn}" Classes="dim" Opacity="0.7"
							   IsVisible="{Binding #Root.Card.HasCreated, FallbackValue=False}"/>
				</StackPanel>
			</Grid>

			<!-- The page's own row, under a rule. -->
			<Border Grid.Row="1" BorderThickness="0,1,0,0" Padding="0,8,0,0" Margin="0,4,0,0"
					BorderBrush="{DynamicResource [Brush] Frame - Golden Dim}"
					IsVisible="{Binding #Root.Footer, Converter={x:Static ObjectConverters.IsNotNull}}">
				<ContentPresenter Content="{Binding #Root.Footer}"/>
			</Border>
		</Grid>
	</Border>
</UserControl>
