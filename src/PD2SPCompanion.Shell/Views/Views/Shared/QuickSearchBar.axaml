<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:chrome="using:Avalonia.Controls.Chrome"
             xmlns:vm="using:PD2SPCompanion.Shell.ViewModels"
             xmlns:base="using:PD2SPCompanion.Shell.CustomControls.Base"
             x:Class="PD2SPCompanion.Shell.Views.QuickSearchBar"
             x:DataType="vm:QuickSearchViewModel"
             chrome:WindowDecorationProperties.ElementRole="User">

	<!-- The window's search, in its top row (QuickSearchViewModel says the rest): the box,
	     and nothing beside it: no arrows stepping through its finds, no count of where among them one is,
	     no funnel opening the item search. The box is quick and
	     short-lived - its finds are gone with its list, and the long list is the Search page's. Over the title
	     bar, which is the window's to drag: its role says the clicks here are its own. -->
	<UserControl.Styles>
		<StyleInclude Source="/Styles/CommonControls/PageText.axaml"/>
		<StyleInclude Source="/Styles/CommonControls/ValueBox.axaml"/>
		<!-- The box's own parts: its magnifier (Picker.axaml) and its cross, a bare glyph (BareIcon.axaml). -->
		<StyleInclude Source="/Styles/CommonControls/Picker.axaml"/>
		<StyleInclude Source="/Styles/CommonControls/BareIcon.axaml"/>
	</UserControl.Styles>

	<!-- 26 tall in the title row's 30 (using up more space, 2px
	     vertically, without changing the size of the top bar): it was 24, with empty room over and under.
	     As wide as the list that opens under it (QuickSearchList). -->
	<Panel Width="440" Height="26" VerticalAlignment="Center">
		<base:SearchBox Name="Box" Classes="value" Height="26"
						FontSize="{StaticResource [Type] Body}" Padding="2,0"
						AutomationProperties.AutomationId="Quick_Box"
						ToolTip.Tip="{L 'Search (Ctrl + F)'}"
						PlaceholderText="{Binding BoxHint}"
						Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"/>
	</Panel>
</UserControl>
