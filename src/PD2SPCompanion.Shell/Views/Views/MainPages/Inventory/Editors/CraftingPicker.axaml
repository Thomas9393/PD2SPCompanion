<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:vm="using:PD2SPCompanion.Shell.ViewModels"
             mc:Ignorable="d" d:DesignWidth="560" d:DesignHeight="760"
             x:Class="PD2SPCompanion.Shell.Views.CraftingPicker"
             x:DataType="vm:CraftingEditor">

	<!-- Crafting. The top says what the item is made by and what that grants; the
	     list below is every family its base can take. Shaped like the corruption
	     panel, because it is the same kind of choice - one thing off, one on. -->
	<Border Classes="veil"
			IsVisible="{Binding IsPickerPresent}"
			Classes.shown="{Binding IsPickerOpen}"
			IsHitTestVisible="{Binding IsPickerOpen}">
		<Panel>
			<Button Classes="backdrop"
				    Command="{Binding ClosePickerCommand}"/>

			<Panel Classes="pickerframe">
				<Border Classes="pickerpanel">
					<DockPanel>
						<Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,8">
							<TextBlock Grid.Column="0" Classes="pickertitle" Text="{L 'Crafting'}"/>


							<Button Grid.Column="2" Classes="spend"
									Command="{Binding ClosePickerCommand}"
									ToolTip.Tip="{L 'Close'}">
								<Path Classes="pin" Data="{StaticResource [Glyph] Close}"/>
							</Button>
						</Grid>

						<!-- 1a. What made it, and what that put on it. -->
						<Border DockPanel.Dock="Top" Classes="section" Padding="10,8"
								Margin="0,0,0,8">
							<StackPanel>
								<TextBlock Classes="fieldname" Margin="0,0,0,4" Text="{L 'Crafted'}"/>

								<TextBlock TextWrapping="Wrap" FontSize="{StaticResource [Type] Body}"
										   Foreground="{DynamicResource [Brush] Rarity - Crafted items}"
										   Text="{Binding Family}"/>

								<!-- An item whose properties no longer match any recipe. Nothing
								     certain to take off, so the swap only adds. -->
								<TextBlock Classes="dim" FontSize="{StaticResource [Type] Small}" Margin="0,4,0,0"
										   TextWrapping="Wrap"
										   IsVisible="{Binding IsUnknown}"
										   Text="{L 'No match. Choosing a family removes nothing.'}"/>

								<ItemsControl ItemsSource="{Binding NowLines}" Margin="0,4,0,0">
									<ItemsControl.ItemTemplate>
										<DataTemplate x:DataType="x:String">
											<TextBlock Text="{Binding}" Classes="affix"/>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</StackPanel>
						</Border>


						<!-- 2. Every family this base can take. -->
						<ScrollViewer HorizontalScrollBarVisibility="Disabled"
								      AllowAutoHide="False">
							<ItemsControl x:Name="CraftList" ItemsSource="{Binding Choices}">
								<ItemsControl.ItemTemplate>
									<DataTemplate x:DataType="vm:CraftChoiceRow">
										<Button Classes="pickone"
												Classes.held="{Binding IsHeld}"
												Command="{Binding $parent[UserControl].((vm:CraftingEditor)DataContext).PickCommand}"
												CommandParameter="{Binding}">
											<StackPanel>
												<TextBlock Classes="crafted" FontSize="{StaticResource [Type] Body}"
														   Text="{Binding Family}"/>
												<ItemsControl ItemsSource="{Binding Lines}" Margin="0,2,0,0">
													<ItemsControl.ItemTemplate>
														<DataTemplate x:DataType="x:String">
															<TextBlock Text="{Binding}" Classes="affix"
																	   TextWrapping="Wrap"/>
														</DataTemplate>
													</ItemsControl.ItemTemplate>
												</ItemsControl>
											</StackPanel>
										</Button>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</ScrollViewer>
					</DockPanel>
				</Border>
			</Panel>
		</Panel>
	</Border>
</UserControl>
