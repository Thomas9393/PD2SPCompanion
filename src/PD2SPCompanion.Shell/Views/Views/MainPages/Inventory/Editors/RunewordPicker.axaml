<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:vm="using:PD2SPCompanion.Shell.ViewModels"
             mc:Ignorable="d" d:DesignWidth="560" d:DesignHeight="760"
             x:Class="PD2SPCompanion.Shell.Views.RunewordPicker"
             x:DataType="vm:RunewordEditor">

	<!-- The runeword builder. The top names the base; then the word chosen, rolled, with the
	     dice to roll it again; then every word the base can hold. Shaped like the crafting
	     panel below it, being the same kind of choice. -->
	<Border Classes="veil"
			IsVisible="{Binding IsPickerPresent}"
			Classes.shown="{Binding IsPickerOpen}"
			IsHitTestVisible="{Binding IsPickerOpen}">
		<Panel>
			<Button Classes="backdrop"
				    Command="{Binding ClosePickerCommand}"/>

			<Panel Classes="pickerframe">
				<Border Classes="pickerpanel">
					<DockPanel>
						<Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,8">
							<TextBlock Grid.Column="0" Classes="pickertitle" Text="{L 'Runeword'}"/>


							<Button Grid.Column="2" Classes="spend"
									Command="{Binding ClosePickerCommand}"
									ToolTip.Tip="{L 'Close'}">
								<Path Classes="pin" Data="{StaticResource [Glyph] Close}"/>
							</Button>
						</Grid>

						<!-- 1a. The base it goes into - a runeword already, which a word picked
						     replaces and the broom stages back to its white base. -->
						<Border DockPanel.Dock="Top" Classes="section" Padding="10,8"
								Margin="0,0,0,8">
							<Grid ColumnDefinitions="*,Auto">
								<StackPanel Grid.Column="0">
									<TextBlock Classes="fieldname" Margin="0,0,0,4" Text="{L 'Base'}"/>
									<TextBlock TextWrapping="Wrap" FontSize="{StaticResource [Type] Body}"
											   Foreground="{DynamicResource [Brush] Rarity - Normal items}"
											   Text="{Binding Base}"/>
								</StackPanel>
								<Button Grid.Column="1" Classes="spend" VerticalAlignment="Top"
										IsVisible="{Binding IsNow}"
										Command="{Binding CleanCommand}"
										ToolTip.Tip="{L 'Remove runeword&#10;Runes are lost'}">
									<Path Classes="pin" Data="{StaticResource [Glyph] Clean}"/>
								</Button>
							</Grid>
						</Border>


						<!-- 2. Every word this base can hold. -->
						<ScrollViewer HorizontalScrollBarVisibility="Disabled"
								      AllowAutoHide="False">
							<ItemsControl ItemsSource="{Binding Choices}">
								<ItemsControl.ItemTemplate>
									<DataTemplate x:DataType="vm:RunewordChoiceRow">
										<Button Classes="pickone"
												Classes.held="{Binding IsHeld}"
												Command="{Binding $parent[UserControl].((vm:RunewordEditor)DataContext).PickCommand}"
												CommandParameter="{Binding}">
											<StackPanel>
												<TextBlock Classes="runeword" FontSize="{StaticResource [Type] Body}"
														   Text="{Binding Name}"/>
												<TextBlock Classes="dim" FontSize="{StaticResource [Type] Small}" Text="{Binding Runes}"/>
												<ItemsControl ItemsSource="{Binding Lines}" Margin="0,2,0,0">
													<ItemsControl.ItemTemplate>
														<DataTemplate x:DataType="x:String">
															<TextBlock Text="{Binding}" Classes="affix"
																	   TextWrapping="Wrap"/>
														</DataTemplate>
													</ItemsControl.ItemTemplate>
												</ItemsControl>
											</StackPanel>
										</Button>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</ScrollViewer>
					</DockPanel>
				</Border>
			</Panel>
		</Panel>
	</Border>
</UserControl>
