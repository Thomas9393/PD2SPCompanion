<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:base="using:PD2SPCompanion.Shell.CustomControls.Base"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:vm="using:PD2SPCompanion.Shell.ViewModels"
			 xmlns:views="using:PD2SPCompanion.Shell.Views"
             mc:Ignorable="d" d:DesignWidth="560" d:DesignHeight="760"
             x:Class="PD2SPCompanion.Shell.Views.RareNamePicker"
             x:DataType="vm:RareNameEditor">

	<!-- Both halves of a rare name, side by side, since the two are picked
	     together and reading one without the other says little. -->
	<Border Classes="veil"
			IsVisible="{Binding IsPickerPresent}"
			Classes.shown="{Binding IsPickerOpen}"
			IsHitTestVisible="{Binding IsPickerOpen}">
		<Panel>
			<Button Classes="backdrop"
					Command="{Binding ClosePickerCommand}"/>

			<Panel Classes="pickerframe">
				<Border Classes="pickerpanel">
					<DockPanel>
						<Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,8">
							<TextBlock Grid.Column="0" Classes="pickertitle" Text="{L 'Name'}"/>

							<!-- A name at random, as the game names a rare. -->
							<base:RollButton Grid.Column="1" Kind="Flawless" Margin="0,0,6,0"
									Command="{Binding RollCommand}"
									ToolTip.Tip="{L 'Random name'}"/>

							<Button Grid.Column="2" Classes="spend"
									Command="{Binding ClosePickerCommand}"
									ToolTip.Tip="{L 'Close'}">
								<Path Classes="pin" Data="{StaticResource [Glyph] Close}"/>
							</Button>
						</Grid>

						<TextBlock FontWeight="Bold" FontFamily="{StaticResource DiabloFont}" DockPanel.Dock="Top" Classes="affix rarename"
								   FontSize="{StaticResource [Type] Heading}" Margin="0,0,0,10"
								   Classes.crafted="{Binding $parent[views:VP_View_Inv_R].((vm:VP_ViewModel_Inv_R)DataContext).Crafting.IsCraft}"
								   Text="{Binding DraftName}"/>

						<Grid ColumnDefinitions="*,12,*">
							<DockPanel Grid.Column="0">
								<base:SearchBox DockPanel.Dock="Top" Classes="value"
										 Margin="0,0,0,8"
										 Padding="2,0"
										 Text="{Binding FirstSearch, Mode=TwoWay}"/>

								<TextBlock DockPanel.Dock="Top" Classes="dim"
										   FontSize="{StaticResource [Type] Small}" Margin="6,0,0,6"
										   IsVisible="{Binding NoFirstNames}"
										   Text="{L 'No match.'}"/>

								<ScrollViewer HorizontalScrollBarVisibility="Disabled"
											  AllowAutoHide="False">
									<ItemsControl x:Name="RareFirstList" ItemsSource="{Binding FirstNames}">
										<ItemsControl.ItemTemplate>
											<DataTemplate x:DataType="vm:RareHalfRow">
												<Button Classes="pickone"
														Classes.held="{Binding IsHeld}"
														Command="{Binding $parent[UserControl].((vm:RareNameEditor)DataContext).PickFirstCommand}"
														CommandParameter="{Binding}">
													<TextBlock Text="{Binding Name}"/>
												</Button>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
								</ScrollViewer>
							</DockPanel>

							<DockPanel Grid.Column="2">
								<base:SearchBox DockPanel.Dock="Top" Classes="value"
										 Margin="0,0,0,8"
										 Padding="2,0"
										 Text="{Binding SecondSearch, Mode=TwoWay}"/>

								<TextBlock DockPanel.Dock="Top" Classes="dim"
										   FontSize="{StaticResource [Type] Small}" Margin="6,0,0,6"
										   IsVisible="{Binding NoSecondNames}"
										   Text="{L 'No match.'}"/>

								<ScrollViewer HorizontalScrollBarVisibility="Disabled"
											  AllowAutoHide="False">
									<ItemsControl x:Name="RareSecondList" ItemsSource="{Binding SecondNames}">
										<ItemsControl.ItemTemplate>
											<DataTemplate x:DataType="vm:RareHalfRow">
												<Button Classes="pickone"
														Classes.held="{Binding IsHeld}"
														Command="{Binding $parent[UserControl].((vm:RareNameEditor)DataContext).PickSecondCommand}"
														CommandParameter="{Binding}">
													<TextBlock Text="{Binding Name}"/>
												</Button>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
								</ScrollViewer>
							</DockPanel>
						</Grid>
					</DockPanel>
				</Border>
			</Panel>
		</Panel>
	</Border>
</UserControl>
