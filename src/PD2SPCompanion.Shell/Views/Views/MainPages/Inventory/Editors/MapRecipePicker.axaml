<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:vm="using:PD2SPCompanion.Shell.ViewModels"
             mc:Ignorable="d" d:DesignWidth="560" d:DesignHeight="760"
             x:Class="PD2SPCompanion.Shell.Views.MapRecipePicker"
             x:DataType="vm:MapRecipeEditor">

	<UserControl.Styles>
		<!-- The brush beside each recipe on the map. -->
		<StyleInclude Source="/Styles/CommonControls/BareIcon.axaml"/>
	</UserControl.Styles>

	<!-- A map's recipes: what the cube does to a map with one item - a Standard of Heroes,
	     an Orb of Fortification, a Catalyst Shard, a Corrupted Ear. The top says which the map shows the mark of;
	     the list is every one the cube has for it, pressed on and pressed off. Shaped like the superior panel. It
	     stays open: a map takes several together. -->
	<Border Classes="veil"
			IsVisible="{Binding IsPickerPresent}"
			Classes.shown="{Binding IsPickerOpen}"
			IsHitTestVisible="{Binding IsPickerOpen}">
		<Panel>
			<Button Classes="backdrop"
				    Command="{Binding ClosePickerCommand}"/>

			<Panel Classes="pickerframe">
				<Border Classes="pickerpanel">
					<DockPanel>
						<Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
							<TextBlock Grid.Column="0" Classes="pickertitle" Text="{L 'Map recipes'}"/>

							<Button Grid.Column="1" Classes="spend"
									Command="{Binding ClosePickerCommand}"
									ToolTip.Tip="{L 'Close'}">
								<Path Classes="pin" Data="{StaticResource [Glyph] Close}"/>
							</Button>
						</Grid>

						<!-- 1. What has been done to it. -->
						<Border DockPanel.Dock="Top" Classes="section" Padding="10,8"
								Margin="0,0,0,8">
							<StackPanel>
								<TextBlock Classes="fieldname" Margin="0,0,0,4" Text="{L 'On this map'}"/>

								<TextBlock Classes="dim" IsVisible="{Binding HasNone}" Text="{L 'None'}"/>

								<!-- Each with its own brush: one taken off, the others kept. -->
								<ItemsControl ItemsSource="{Binding HeldRows}">
									<ItemsControl.ItemTemplate>
										<DataTemplate x:DataType="vm:MapRecipeHeldRow">
											<Grid ColumnDefinitions="*,Auto" Margin="0,1">
												<TextBlock Grid.Column="0" Text="{Binding Name}" Classes="affix" VerticalAlignment="Center"/>
												<Button Grid.Column="1" Classes="bareicon"
														Command="{Binding $parent[UserControl].((vm:MapRecipeEditor)DataContext).TakeOffCommand}"
														CommandParameter="{Binding}"
														ToolTip.Tip="{L 'Remove recipe'}">
													<Path Classes="pin" Data="{StaticResource [Glyph] Clean}"/>
												</Button>
											</Grid>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</StackPanel>
						</Border>

						<!-- 2. Every one the cube has for this map: its name, and what it writes. -->
						<ScrollViewer HorizontalScrollBarVisibility="Disabled"
								      AllowAutoHide="False">
							<ItemsControl ItemsSource="{Binding Choices}">
								<ItemsControl.ItemTemplate>
									<DataTemplate x:DataType="vm:MapRecipeRow">
										<Button Classes="pickone"
												Classes.held="{Binding IsHeld}"
												Command="{Binding $parent[UserControl].((vm:MapRecipeEditor)DataContext).PickCommand}"
												CommandParameter="{Binding}">
											<StackPanel>
												<TextBlock Classes="fieldname" Margin="0,0,0,2" Text="{Binding Name}"/>
												<ItemsControl ItemsSource="{Binding Lines}">
													<ItemsControl.ItemTemplate>
														<DataTemplate x:DataType="x:String">
															<TextBlock Text="{Binding}" Classes="affix"
																	   TextWrapping="Wrap"/>
														</DataTemplate>
													</ItemsControl.ItemTemplate>
												</ItemsControl>
											</StackPanel>
										</Button>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</ScrollViewer>
					</DockPanel>
				</Border>
			</Panel>
		</Panel>
	</Border>
</UserControl>
