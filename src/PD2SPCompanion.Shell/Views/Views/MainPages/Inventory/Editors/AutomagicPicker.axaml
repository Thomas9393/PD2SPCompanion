<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:base="using:PD2SPCompanion.Shell.CustomControls.Base"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:vm="using:PD2SPCompanion.Shell.ViewModels"
             mc:Ignorable="d" d:DesignWidth="560" d:DesignHeight="760"
             x:Class="PD2SPCompanion.Shell.Views.AutomagicPicker"
             x:DataType="vm:AutomagicEditor">

	<!-- Automagic, just like superior. The top says what row the item carries; the list
	     below is every row of its base's group, and none - each with the item levels it spawns at, marked where the
	     item's level is outside them. Shaped as the superior picker is. -->
	<Border Classes="veil"
			IsVisible="{Binding IsPickerPresent}"
			Classes.shown="{Binding IsPickerOpen}"
			IsHitTestVisible="{Binding IsPickerOpen}">
		<Panel>
			<Button Classes="backdrop"
				    Command="{Binding ClosePickerCommand}"/>

			<Panel Classes="pickerframe">
				<Border Classes="pickerpanel">
					<DockPanel>
						<Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,8">
							<TextBlock Grid.Column="0" Classes="pickertitle" Text="{L 'Automod'}"/>

							<!-- One at random, as the game rolls it. -->
							<base:RollButton Grid.Column="1" Kind="Flawless" Margin="0,0,6,0"
									Command="{Binding RollCommand}"
									ToolTip.Tip="{L 'Random automod'}"/>

							<Button Grid.Column="2" Classes="spend"
									Command="{Binding ClosePickerCommand}"
									ToolTip.Tip="{L 'Close'}">
								<Path Classes="pin" Data="{StaticResource [Glyph] Close}"/>
							</Button>
						</Grid>

						<!-- 1. What it carries now. -->
						<Border DockPanel.Dock="Top" Classes="section" Padding="10,8"
								Margin="0,0,0,8">
							<Grid ColumnDefinitions="*,Auto">
								<StackPanel Grid.Column="0" Margin="0,0,8,0">
									<TextBlock Classes="fieldname" Margin="0,0,0,4" Text="{L 'Bonus'}"/>

									<TextBlock Classes="dim" IsVisible="{Binding HasNone}" Text="{L 'None'}"/>

									<ItemsControl ItemsSource="{Binding NowLines}">
										<ItemsControl.ItemTemplate>
											<DataTemplate x:DataType="x:String">
												<TextBlock Text="{Binding}" Classes="affix"/>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
								</StackPanel>

								<!-- The brush takes it off, as the corruption's does; it was a "None" row in the list. -->
								<Button Grid.Column="1" Classes="spend bin" VerticalAlignment="Top"
										IsEnabled="{Binding CanTakeOff}"
										Command="{Binding TakeOffCommand}"
										ToolTip.Tip="{L 'Remove automod'}">
									<Path Classes="pin" Data="{StaticResource [Glyph] Clean}"/>
								</Button>
							</Grid>
						</Border>

						<!-- 2. None, and every row of the base's group. -->
						<ScrollViewer HorizontalScrollBarVisibility="Disabled"
								      AllowAutoHide="False">
							<ItemsControl ItemsSource="{Binding Choices}">
								<ItemsControl.ItemTemplate>
									<DataTemplate x:DataType="vm:AutomagicChoiceRow">
										<Button Classes="pickone"
												Classes.held="{Binding IsHeld}"
												Command="{Binding $parent[UserControl].((vm:AutomagicEditor)DataContext).PickCommand}"
												CommandParameter="{Binding}">
											<Grid ColumnDefinitions="*,Auto">
												<ItemsControl Grid.Column="0" ItemsSource="{Binding Lines}">
													<ItemsControl.ItemTemplate>
														<DataTemplate x:DataType="x:String">
															<TextBlock Text="{Binding}" Classes="affix"
																	   TextWrapping="Wrap"/>
														</DataTemplate>
													</ItemsControl.ItemTemplate>
												</ItemsControl>
												<TextBlock Grid.Column="1" Classes="dim" Margin="8,0,0,0"
														   Classes.needslevel="{Binding IsAboveLevel}"
														   FontSize="{StaticResource [Type] Small}" VerticalAlignment="Center"
														   Text="{Binding Note}"/>
											</Grid>
										</Button>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</ScrollViewer>
					</DockPanel>
				</Border>
			</Panel>
		</Panel>
	</Border>
</UserControl>
