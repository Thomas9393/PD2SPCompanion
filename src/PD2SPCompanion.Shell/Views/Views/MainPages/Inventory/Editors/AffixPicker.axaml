<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:base="using:PD2SPCompanion.Shell.CustomControls.Base"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:vm="using:PD2SPCompanion.Shell.ViewModels"
			 xmlns:data="using:PD2SPCompanion.Core.Items"
			 xmlns:views="using:PD2SPCompanion.Shell.Views"
             mc:Ignorable="d" d:DesignWidth="560" d:DesignHeight="760"
             x:Class="PD2SPCompanion.Shell.Views.AffixPicker"
             x:DataType="vm:AffixEditor">

	<!-- Affixes. The top is the item's slots, prefix beside suffix as the file keeps
	     them; clicking a side aims the list below at it. Each pick, roll and emptied or
	     removed slot is written at once, as the corruption's picker writes, and rebuilds the item's properties from the
	     affixes it ends up
	     with - which is the point of changing one here rather than typing a property in
	     by hand. The numbers are the property rows' to change after. -->
	<Border Classes="veil"
			IsVisible="{Binding IsAffixPickerPresent}"
			Classes.shown="{Binding IsAffixPickerOpen}"
			IsHitTestVisible="{Binding IsAffixPickerOpen}">
		<Panel>
			<Button Classes="backdrop" Command="{Binding CloseAffixPickerCommand}"/>

			<Panel Classes="pickerframe">
				<Border Classes="pickerpanel">
					<Grid>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="{Binding PoolRowHeight}"/>
						</Grid.RowDefinitions>
						<Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
							<TextBlock Grid.Column="0" Classes="pickertitle" Text="{L 'Affixes'}"/>

							<!-- Every slot rolled again is the section header's die alone: it stood
							     here too, the same act twice. -->

							<!-- No tick: every act writes at once, and the properties it rebuilt are said on the strip. -->
							<Button Grid.Column="1" Classes="spend"
									Command="{Binding CloseAffixPickerCommand}"
									ToolTip.Tip="{L 'Close'}">
								<Path Classes="pin" Data="{StaticResource [Glyph] Close}"/>
							</Button>
						</Grid>

						<!-- The slots, as the item holds them now. -->
						<Border Grid.Row="1" Classes="section" Padding="10,8"
								Margin="0,0,0,8">
							<StackPanel>
								<!-- How many pairs the item carries. One at least, three at most; - takes the last
								     one off at once, + opens an empty one and aims the list at it. -->
								<Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,6">
									<TextBlock Grid.Column="0" Classes="fieldname" Margin="0"
											   VerticalAlignment="Center" Text="{L 'Slots'}"/>

									<Button Grid.Column="1" Classes="spend" Margin="0,0,4,0"
											IsEnabled="{Binding CanRemoveSlot}"
											Command="{Binding RemoveSlotCommand}"
											ToolTip.Tip="{L 'Remove slot'}">
										<Path Classes="pin" Data="{StaticResource [Glyph] Minus}"/>
									</Button>

									<Button Grid.Column="2" Classes="spend"
											IsEnabled="{Binding CanAddSlot}"
											Command="{Binding AddSlotCommand}"
											ToolTip.Tip="{L 'Add slot'}">
										<Path Classes="pin" Data="{StaticResource [Glyph] Plus}"/>
									</Button>
								</Grid>

								<ItemsControl ItemsSource="{Binding StagedPairs}">
									<ItemsControl.ItemTemplate>
										<DataTemplate x:DataType="vm:AffixSlotRow">
											<!-- No mark of a change: each is written at once, said on the strip and taken back by the
											     undo, as in every other picker (the * went). -->
											<Grid ColumnDefinitions="*,Auto,*" Margin="0,2">
												<Button Grid.Column="0" Classes="affixslot"
													Classes.aimed="{Binding PrefixAimed}"
														HorizontalContentAlignment="Right"
														Command="{Binding $parent[UserControl].((vm:AffixEditor)DataContext).AimAffixCommand}"
														CommandParameter="{Binding Slot, StringFormat='{}{0}:prefix'}">
													<TextBlock Classes="affix magic" Text="{Binding PrefixName}"/>
												</Button>

												<TextBlock Grid.Column="1" Classes="affix dash" Margin="8,0" Text="-"/>

												<Button Grid.Column="2" Classes="affixslot"
													Classes.aimed="{Binding SuffixAimed}"
														HorizontalContentAlignment="Left"
														Command="{Binding $parent[UserControl].((vm:AffixEditor)DataContext).AimAffixCommand}"
														CommandParameter="{Binding Slot, StringFormat='{}{0}:suffix'}">
													<TextBlock Classes="affix magic" Text="{Binding SuffixName}"/>
												</Button>
											</Grid>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</StackPanel>
						</Border>

						<!-- What the aimed slot holds. Between the slots and the pool on purpose: it is
						     the answer to the row above and the question the list below is asking. Its
						     name alone: the numbers it gave are the property rows'. -->
						<Border Grid.Row="2" Classes="section" Padding="10,8" Margin="0,0,0,8">
							<DockPanel>
								<!-- What fills the slot - a random affix, or none - is asked here, of the slot, and
								     not on the list's search line, where it read as acting on the list. -->
								<Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto">
									<TextBlock Grid.Column="0" Classes="fieldname" Margin="0"
											   Classes.dim="{Binding NoChosenAffix}"
											   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
											   Text="{Binding ChosenAffixHeading}"/>

									<!-- The Flawless Skull: this slot's affix rolled, a tier under the Perfect Skull's every slot. -->
									<base:RollButton Kind="Flawless" Grid.Column="1" Margin="0,0,6,0"
											Command="{Binding RollAffixCommand}"
											ToolTip.Tip="{L 'Random affix'}"/>

									<!-- The one way to clear here (a dustbin button and an X button stood here).
									     The brush: what takes a thing off the item; the cross is Close alone. -->
									<Button Grid.Column="2" Classes="spend bin"
											Command="{Binding ClearAffixCommand}"
											ToolTip.Tip="{L 'Remove affix'}">
										<Path Classes="pin" Data="{StaticResource [Glyph] Clean}"/>
									</Button>
								</Grid>
							</DockPanel>
						</Border>

						<!-- What the list is aimed at, and the ways to fill it. -->
						<Border Grid.Row="3" Classes="section" Padding="10,8" ClipToBounds="True">
							<DockPanel>
								<Button DockPanel.Dock="Top" Classes="fold" Margin="0,0,0,6"
										Command="{Binding ToggleAffixPoolCommand}">
									<Grid ColumnDefinitions="Auto,*">
										<Path Grid.Column="0" Classes="chevron"
											  Classes.open="{Binding IsAffixPoolOpen}"
											  Data="{StaticResource [Glyph] Chevron}"/>
										<TextBlock Grid.Column="1" Classes="fieldname"
												   VerticalAlignment="Center"
												   Text="{Binding AffixPoolHeader}"/>
									</Grid>
								</Button>

								<Panel IsVisible="{Binding IsAffixPoolOpen}">
									<DockPanel>
								<Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*"
									  Margin="2,0,2,8">
									<TextBlock Grid.Column="0" Classes="fieldname" Margin="0,0,8,0"
											   VerticalAlignment="Center"
											   Text="{Binding AffixSideName}"/>

									<!-- As every picker's search box (it was a centred "search"). -->
									<base:SearchBox Grid.Column="1" Classes="value"
											 Padding="2,0"
											 Text="{Binding AffixSearch, Mode=TwoWay}"/>
								</Grid>

								<!-- An empty list says so, and where the search finds something on the other side, that it is
								     there. Affixes another slot's group rules out are listed, greyed, not hidden. -->
								<TextBlock DockPanel.Dock="Top" Classes="dim" FontSize="{StaticResource [Type] Small}"
										   Margin="2,0,2,8" TextWrapping="Wrap"
										   IsVisible="{Binding NoAffixChoices}"
										   Text="{Binding NoChoicesNote}"/>

								<!-- Only the rows in sight are made, as the property picker's (PropertyPicker.axaml, where
								     the scroll viewer and the handed panel are explained): a hundred and more rows of
								     five controls each were built at every open - 95 ms of it (a trace). -->
									<ItemsControl x:Name="AffixList" ItemsSource="{Binding AffixChoices}">
										<!-- The line telling twin rows apart, dim - the panel's row rule paints it as loud as the
										     stat (PickerAside.axaml). -->
										<ItemsControl.Styles>
											<StyleInclude Source="/Styles/CommonControls/PickerAside.axaml"/>
										</ItemsControl.Styles>
										<ItemsControl.Template>
											<ControlTemplate>
												<ScrollViewer HorizontalScrollBarVisibility="Disabled" AllowAutoHide="False">
													<ItemsPresenter ItemsPanel="{TemplateBinding ItemsPanel}"/>
												</ScrollViewer>
											</ControlTemplate>
										</ItemsControl.Template>
										<ItemsControl.ItemsPanel>
											<ItemsPanelTemplate>
												<VirtualizingStackPanel/>
											</ItemsPanelTemplate>
										</ItemsControl.ItemsPanel>
										<ItemsControl.ItemTemplate>
											<DataTemplate x:DataType="vm:AffixChoiceRow">
												<Button Classes="pickone"
														Classes.held="{Binding IsHeld}"
														IsEnabled="{Binding CanPick}"
														Command="{Binding $parent[UserControl].((vm:AffixEditor)DataContext).ChooseAffixCommand}"
														CommandParameter="{Binding}">
													<Grid ColumnDefinitions="128,*,Auto">
														<TextBlock Grid.Column="0" Classes="affix magic"
																   Classes.needslevel="{Binding IsAboveLevel}"
																   Text="{Binding Name}"/>
														<StackPanel Grid.Column="1">
															<TextBlock TextWrapping="Wrap"
																	   Classes.needslevel="{Binding IsAboveLevel}"
																	   Text="{Binding Readable}"/>
															<!-- What tells it from a row that reads the same, dim, as the automagic picker's note. -->
															<TextBlock Classes="dim" TextWrapping="Wrap"
																	   IsVisible="{Binding HasTelling}"
																	   Text="{Binding Telling}"/>
														</StackPanel>
														<TextBlock Grid.Column="2" Classes="needslevel"
																   FontSize="{StaticResource [Type] Small}" Margin="8,0,0,0"
																   VerticalAlignment="Center"
																   Text="{Binding LevelNote}"/>
													</Grid>
												</Button>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
									</DockPanel>
								</Panel>
							</DockPanel>
						</Border>
					</Grid>
				</Border>
			</Panel>
		</Panel>
	</Border>
</UserControl>
