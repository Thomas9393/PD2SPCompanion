<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:base="using:PD2SPCompanion.Shell.CustomControls.Base"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:vm="using:PD2SPCompanion.Shell.ViewModels"
             mc:Ignorable="d" d:DesignWidth="560" d:DesignHeight="760"
             x:Class="PD2SPCompanion.Shell.Views.DesecrationPicker"
             x:DataType="vm:DesecrationEditor">

	<!-- Desecration. Shaped like the corruption panel: the top says what the amulet has or
	     what has been chosen, the list is the eight it draws from. The file keeps only
	     whether the mod was enhanced damage, so where the item cannot tell which it was the
	     player says - that answer is what a clean takes off. -->
	<Border Classes="veil"
			IsVisible="{Binding IsPickerPresent}"
			Classes.shown="{Binding IsPickerOpen}"
			IsHitTestVisible="{Binding IsPickerOpen}">
		<Panel>
			<Button Classes="backdrop"
					Command="{Binding ClosePickerCommand}"/>

			<Panel Classes="pickerframe">
				<Border Classes="pickerpanel">
					<DockPanel>
						<Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,8">
							<TextBlock Grid.Column="0" Classes="pickertitle" Text="{L 'Desecration'}"/>

							<!-- One desecration at random, staged at once, as a pick is (a pick is the change - written at once, and taken back by Ctrl + Z). -->
							<base:RollButton Kind="Flawless" Grid.Column="1" Margin="0,0,6,0"
									IsEnabled="{Binding CanPick}"
									Command="{Binding RollCommand}"
									ToolTip.Tip="{L 'Random desecration'}"/>

							<Button Grid.Column="2" Classes="spend"
									Command="{Binding ClosePickerCommand}"
									ToolTip.Tip="{L 'Close'}">
								<Path Classes="pin" Data="{StaticResource [Glyph] Close}"/>
							</Button>
						</Grid>

						<!-- 1a. What it carries: the desecration, and the way back - "None" with nothing, so the first pick
						     moves nothing below. -->
						<Border DockPanel.Dock="Top" Classes="section" Padding="10,8"
								Margin="0,0,0,8">
							<Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto">
								<StackPanel Grid.Column="0" Margin="0,0,8,0">
									<TextBlock Classes="fieldname" Margin="0,0,0,4" Text="{L 'Desecrated'}"/>
									<TextBlock Classes="dim" IsVisible="{Binding !IsDesecrated}" Text="{L 'None'}"/>
									<TextBlock TextWrapping="Wrap" FontSize="{StaticResource [Type] Body}"
											   Foreground="{DynamicResource [Text] Corrupted}"
											   IsVisible="{Binding IsDesecrated}"
											   Text="{Binding Summary}"/>
								</StackPanel>


								<Button Grid.Column="2" Classes="spend bin"
										VerticalAlignment="Top"
										IsEnabled="{Binding CanClean}"
										Command="{Binding CleanCommand}"
										ToolTip.Tip="{L 'Remove desecration&#10;Rerolls affected stats'}">
									<Path Classes="pin" Data="{StaticResource [Glyph] Clean}"/>
								</Button>

								<!-- Which mod it is, where the item cannot tell. -->
								<StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,8,0,0"
											IsVisible="{Binding IsUnclear}">
									<TextBlock Classes="fieldname" Margin="0,0,0,4" Text="{L 'Choose mod'}"/>
									<!-- Why the list below is greyed, while it is. -->
									<TextBlock Classes="dim" FontSize="{StaticResource [Type] Small}" Margin="0,0,0,4"
											   TextWrapping="Wrap" IsVisible="{Binding AwaitsAnswer}"
											   Text="{L 'Its lines cannot tell which. Needed before a change.'}"/>
									<ItemsControl ItemsSource="{Binding Answers}">
										<ItemsControl.ItemsPanel>
											<ItemsPanelTemplate>
												<WrapPanel/>
											</ItemsPanelTemplate>
										</ItemsControl.ItemsPanel>
										<ItemsControl.ItemTemplate>
											<DataTemplate x:DataType="vm:DesecrationChoiceRow">
												<Button Classes="pickone" Margin="0,0,6,4"
														Classes.held="{Binding IsHeld}"
														Command="{Binding $parent[UserControl].((vm:DesecrationEditor)DataContext).TellCommand}"
														CommandParameter="{Binding}">
													<TextBlock Text="{Binding Readable}"/>
												</Button>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
								</StackPanel>
							</Grid>
						</Border>

						<!-- 2. The pool: the top band of the amulet's corruptions. -->
						<ScrollViewer HorizontalScrollBarVisibility="Disabled"
									  AllowAutoHide="False">
							<StackPanel>
								<Grid ColumnDefinitions="*,Auto" Margin="8,0,8,4">
									<TextBlock Grid.Column="0" Classes="pickhead" Text="{L 'High rarity'}"/>
								</Grid>

								<ItemsControl x:Name="DesecrationList" ItemsSource="{Binding Choices}">
									<ItemsControl.ItemTemplate>
										<DataTemplate x:DataType="vm:DesecrationChoiceRow">
											<Button Classes="pickone"
													Classes.held="{Binding IsHeld}"
													IsEnabled="{Binding $parent[UserControl].((vm:DesecrationEditor)DataContext).CanPick}"
													Command="{Binding $parent[UserControl].((vm:DesecrationEditor)DataContext).PickCommand}"
													CommandParameter="{Binding}">
												<Grid ColumnDefinitions="*,Auto">
													<TextBlock Grid.Column="0" Text="{Binding Readable}"
															   TextWrapping="Wrap"/>
													<TextBlock Grid.Column="1" Classes="dim"
															   Margin="8,0,0,0"
															   VerticalAlignment="Center"
															   Text="{Binding Chance}"/>
												</Grid>
											</Button>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</StackPanel>
						</ScrollViewer>
					</DockPanel>
				</Border>
			</Panel>
		</Panel>
	</Border>
</UserControl>
