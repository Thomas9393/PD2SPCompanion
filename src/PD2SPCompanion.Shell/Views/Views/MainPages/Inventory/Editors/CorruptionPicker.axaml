<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:base="using:PD2SPCompanion.Shell.CustomControls.Base"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:vm="using:PD2SPCompanion.Shell.ViewModels"
             mc:Ignorable="d" d:DesignWidth="560" d:DesignHeight="760"
             x:Class="PD2SPCompanion.Shell.Views.CorruptionPicker"
             x:DataType="vm:CorruptionEditor">

	<!-- Corruption. The top says what the item has or what has been chosen for it; the
	     list below is everything the cube could give it, in the three groups the wiki
	     uses - which are the odds, since the band that selects an outcome is as wide as
	     its chance. -->
	<Border Classes="veil"
			IsVisible="{Binding IsPickerPresent}"
			Classes.shown="{Binding IsPickerOpen}"
			IsHitTestVisible="{Binding IsPickerOpen}">
		<Panel>
			<Button Classes="backdrop"
					Command="{Binding ClosePickerCommand}"/>

			<Panel Classes="pickerframe">
				<Border Classes="pickerpanel">
					<DockPanel>
						<Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,8">
							<TextBlock Grid.Column="0" Classes="pickertitle" Text="{L 'Corruption'}"/>

							<!-- One corruption at random, staged at once, as a pick is (a pick is the change - written at once, and taken back by Ctrl + Z). -->
							<base:RollButton Kind="Flawless" Grid.Column="1" Margin="0,0,6,0"
									Command="{Binding RollCommand}"
									ToolTip.Tip="{L 'Random corruption'}"/>

							<Button Grid.Column="2" Classes="spend"
									Command="{Binding ClosePickerCommand}"
									ToolTip.Tip="{L 'Close'}">
								<Path Classes="pin" Data="{StaticResource [Glyph] Close}"/>
							</Button>
						</Grid>

						<!-- 1a. What it carries: the corruption, and the way back. Or a shard spent to no effect - two
						     dungeons in three - which the game leaves unable to take another. Shown
						     with nothing too, "None", as the superior picker's is: the first pick moves nothing below. -->
						<Border DockPanel.Dock="Top" Classes="section" Padding="10,8"
								Margin="0,0,0,8">
							<Grid ColumnDefinitions="*,Auto,Auto">
								<StackPanel Grid.Column="0" Margin="0,0,8,0">
									<TextBlock Classes="fieldname" Margin="0,0,0,4" Text="{L 'Corrupted'}"/>
									<TextBlock Classes="dim" IsVisible="{Binding !HoldsMark}" Text="{L 'None'}"/>
									<TextBlock TextWrapping="Wrap" FontSize="{StaticResource [Type] Body}"
											   Foreground="{DynamicResource [Text] Corrupted}"
											   IsVisible="{Binding HoldsMark}"
											   Text="{Binding Summary}"/>
								</StackPanel>

								<!-- Cleaning is staged at once, as a pick is: it rerolls what the corruption touched,
								     which the bin's tooltip warns of; UNDO on the page takes it back. -->

								<Button Grid.Column="2" Classes="spend bin"
										VerticalAlignment="Top"
										IsEnabled="{Binding CanClean}" ToolTip.ShowOnDisabled="True"
										Command="{Binding CleanCommand}"
										ToolTip.Tip="{Binding CleanHint}">
									<Path Classes="pin" Data="{StaticResource [Glyph] Clean}"/>
								</Button>
							</Grid>
						</Border>

						<!-- 2. The pool, grouped as the wiki groups it. A pick on a corrupted item takes its corruption's
						     place, the clean with it. -->
						<ScrollViewer HorizontalScrollBarVisibility="Disabled"
									  AllowAutoHide="False">
							<ItemsControl x:Name="CorruptionList" ItemsSource="{Binding Choices}">
								<ItemsControl.ItemTemplate>
									<DataTemplate x:DataType="vm:CorruptionTier">
										<StackPanel Margin="0,0,0,10">
											<Grid ColumnDefinitions="*,Auto" Margin="8,0,8,4">
												<TextBlock Grid.Column="0" Classes="pickhead"
														   Text="{Binding Name}"/>
												<TextBlock Grid.Column="1" Classes="dim"
														   VerticalAlignment="Center"
														   Text="{Binding Chance}"/>
											</Grid>

											<ItemsControl ItemsSource="{Binding Options}">
												<ItemsControl.ItemTemplate>
													<DataTemplate x:DataType="vm:CorruptionChoiceRow">
														<Button Classes="pickone"
																Classes.held="{Binding IsHeld}"
																IsEnabled="{Binding $parent[UserControl].((vm:CorruptionEditor)DataContext).CanPick}"
																Command="{Binding $parent[UserControl].((vm:CorruptionEditor)DataContext).PickCommand}"
																CommandParameter="{Binding}">
															<Grid ColumnDefinitions="*,Auto">
																<TextBlock Grid.Column="0" Text="{Binding Readable}"
																		   TextWrapping="Wrap"/>
																<TextBlock Grid.Column="1" Classes="dim"
																		   Margin="8,0,0,0"
																		   VerticalAlignment="Center"
																		   Text="{Binding Chance}"/>
															</Grid>
														</Button>
													</DataTemplate>
												</ItemsControl.ItemTemplate>
											</ItemsControl>
										</StackPanel>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</ScrollViewer>
					</DockPanel>
				</Border>
			</Panel>
		</Panel>
	</Border>
</UserControl>
