<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:vm="using:PD2SPCompanion.Shell.ViewModels"
			 xmlns:views="using:PD2SPCompanion.Shell.Views"

             mc:Ignorable="d"
			 d:DesignWidth="{DynamicResource [UI] Page PreviewWidth}"
			 d:DesignHeight="{DynamicResource [UI] Page PreviewHeight}"

             x:Class="PD2SPCompanion.Shell.Views.VP_View_Experimental_L"
			 x:DataType="vm:VP_ViewModel_Experimental_L"

			 Background="{DynamicResource [UI] ImageBrush - Background#2}"
			 CornerRadius="{DynamicResource [UI] MainViewPage_L CornerSize}">
	<Design.DataContext>
		<vm:VP_ViewModel_Experimental_L/>
	</Design.DataContext>

	<UserControl.Styles>
		<StyleInclude Source="/Styles/CommonControls/Section.axaml"/>
		<StyleInclude Source="/Styles/CommonControls/Alert.axaml"/>
		<StyleInclude Source="/Styles/CommonControls/PageText.axaml"/>
		<StyleInclude Source="/Styles/CommonControls/SettingRow.axaml"/>
		<StyleInclude Source="/Styles/CommonControls/ComboBox.axaml"/>
		<StyleInclude Source="/Styles/CommonControls/Tick.axaml"/>
		<StyleInclude Source="/Styles/CommonControls/BareIcon.axaml"/>
		<StyleInclude Source="/Styles/CommonControls/SpendButton.axaml"/>
		<StyleInclude Source="/Styles/CommonControls/PickField.axaml"/>

		<!-- Two ways to have the game, so two buttons rather than a number to type. -->
	</UserControl.Styles>

	<Panel>
	<ScrollViewer HorizontalScrollBarVisibility="Disabled" AllowAutoHide="False">
		<StackPanel Margin="16">
			<TextBlock Classes="title" Text="{L 'Experimental'}" Margin="0,0,0,12"/>

			<Border Classes="section">
				<StackPanel Margin="16,14">
					<TextBlock Classes="heading"
							   Text="{L 'Modded single player'}" Margin="0,0,0,12"/>

					<!-- Each thing this page mods is a row: what it is on the left, what sets it
					     on the right. The buttons below act on all of them at once. -->
					<Grid Classes="settingrow" ColumnDefinitions="*,Auto">
						<TextBlock Grid.Column="0" Classes="body" VerticalAlignment="Center"
								   Text="{L 'Monster density'}"/>
						<!-- 1x is the game as it ships. MAX is every chosen area at the engine's
						     ceiling (10000). -->
						<ComboBox Grid.Column="1" Classes="slots" Width="{StaticResource [UI] Drop Wide}" MinWidth="0"
								  ItemsSource="{Binding DensityOptions}"
								  SelectedIndex="{Binding DensityIndex}"/>
					</Grid>

					<!-- More monsters per spawn: past the density ceiling, the one lever left. -->
					<Grid Classes="settingrow" ColumnDefinitions="*,Auto" Margin="0,10,0,0">
						<TextBlock Grid.Column="0" Classes="body" VerticalAlignment="Center"
								   Text="{L 'Monster pack size'}"/>
						<ComboBox Grid.Column="1" Classes="slots" Width="{StaticResource [UI] Drop Wide}" MinWidth="0"
								  ItemsSource="{Binding PackOptions}"
								  SelectedIndex="{Binding PackIndex}"/>
					</Grid>

					<!-- Pack size is the monster's, so it changes every monster everywhere, whatever the areas. -->
					<Grid Classes="settingrow" ColumnDefinitions="*,Auto,Auto" Margin="0,10,0,0">
						<TextBlock Grid.Column="0" Classes="body" VerticalAlignment="Center"
								   Text="{L 'Areas'}"/>
						<!-- The warning, kept out of sight until wanted: the tooltip says it.
						     The app's warning mark (Alert.axaml). -->
						<Path Classes="pin alert" Data="{StaticResource [Glyph] Alert}" Grid.Column="1" Margin="0,0,10,0" IsVisible="{Binding PacksReachFurther}" ToolTip.Tip="{L 'Affects every monster in every area'}"/>
						<ComboBox Grid.Column="2" Classes="slots" Width="{StaticResource [UI] Drop Wide}" MinWidth="0"
								  ItemsSource="{Binding ScopeOptions}"
								  SelectedIndex="{Binding ScopeIndex}"/>
					</Grid>

					<!-- Drops: treasureclassex.txt, see DropOverride. Ordinary kills only, since
					     champions, uniques and bosses already drop several. -->
					<Grid Classes="settingrow" ColumnDefinitions="*,Auto" Margin="0,10,0,0" Background="Transparent"
						  ToolTip.Tip="{L 'Ordinary monsters always drop'}">
						<TextBlock Grid.Column="0" Classes="body" VerticalAlignment="Center"
								   Text="{L 'Every kill drops'}"/>
						<ToggleButton Grid.Column="1" Classes="tick"
									  IsChecked="{Binding EveryKill, Mode=TwoWay}">
							<Path Data="{StaticResource [Glyph] Tick}"
								  IsVisible="{Binding EveryKill}"/>
						</ToggleButton>
					</Grid>

					<!-- The drop panel: PD2's special items and the high runes, each its own
					     multiple, with the odds and presets. What it holds is said here; it opens over the page. -->
					<!-- A field that opens the panel, saying the preset (with text showing the
					     current preset and still the icon at the right side): the pick field, as the drop
					     boxes beside it. -->
					<Grid Classes="settingrow" ColumnDefinitions="*,Auto" Margin="0,10,0,0">
						<TextBlock Grid.Column="0" Classes="body" VerticalAlignment="Center"
								   Text="{L 'Drop rates'}"/>
						<Button Grid.Column="1" Classes="pickfield" Width="{StaticResource [UI] Drop Wide}"
								Command="{Binding DropPanel.OpenCommand}"
								ToolTip.Tip="{L 'Special items, runes and gems'}">
							<Grid ColumnDefinitions="*,Auto">
								<TextBlock Grid.Column="0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
										   Text="{Binding DropPanel.CurrentPresetName}"/>
								<Path Grid.Column="1" Classes="pin" Margin="6,0,0,0" VerticalAlignment="Center"
									  Data="{StaticResource [Glyph] Open}"/>
							</Grid>
						</Button>
					</Grid>

					<!-- A tome is permanent stock at five vendors, so this one needs no item
					     table touched: it appends a cube recipe and leaves the leg's alone. -->
					<!-- Transparent rather than unset, so the tooltip answers to the whole row
					     rather than only to the words and the box. -->
					<Grid Classes="settingrow" ColumnDefinitions="*,Auto" Margin="0,10,0,0" Background="Transparent"
							  ToolTip.Tip="{Binding CowPortalHint}">
						<TextBlock Grid.Column="0" Classes="body" VerticalAlignment="Center"
								   Text="{L 'Alternative cow portal recipe'}"/>
						<ToggleButton Grid.Column="1" Classes="tick"
									  IsChecked="{Binding CowPortal, Mode=TwoWay}">
							<Path Data="{StaticResource [Glyph] Tick}"
								  IsVisible="{Binding CowPortal}"/>
						</ToggleButton>
					</Grid>

					<!-- The card's actions, as Character Creation's CREATE: compact, labelled, on the right, flat -
					     the primary filled and first, the popups' order. No LAUNCH: the shortcut starts the game this way for
					     good, and the editor starting the game it must not write beside was one way too many. -->
					<StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" Margin="0,14,0,0">
						<Button Height="{StaticResource [UI] Button Height}" MinWidth="{StaticResource [UI] Button Width}"
								HorizontalContentAlignment="Stretch"
								Theme="{DynamicResource [CtrlThm] Button_Primary}"
								Command="{Binding ApplyCommand}"
								IsEnabled="{Binding CanApply}"
								ToolTip.Tip="{Binding ApplyHint}" ToolTip.ShowOnDisabled="True">
							<!-- The icon at the left edge, the label centred in the space it leaves. -->
							<Grid ColumnDefinitions="Auto,*">
								<Path Classes="pin label" Data="{StaticResource [Glyph] Save}" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
								<TextBlock Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,0,0,0" Text="{L 'APPLY'}"/>
							</Grid>
						</Button>
						<Button Height="{StaticResource [UI] Button Height}" MinWidth="{StaticResource [UI] Button Width}"
								HorizontalContentAlignment="Stretch"
								Theme="{DynamicResource [CtrlThm] Button_Secondary}"
								IsEnabled="{Binding CanRemove}"
								Command="{Binding RemoveCommand}"
								ToolTip.Tip="{Binding RemoveHint}" ToolTip.ShowOnDisabled="True">
							<!-- The icon at the left edge, the label centred in the space it leaves. -->
							<Grid ColumnDefinitions="Auto,*">
								<Path Classes="pin label" Data="{StaticResource [Glyph] Bin}" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
								<TextBlock Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,0,0,0" Text="{L 'REMOVE'}"/>
							</Grid>
						</Button>
						<Button Height="{StaticResource [UI] Button Height}" MinWidth="{StaticResource [UI] Button Width}"
								HorizontalContentAlignment="Stretch"
								Theme="{DynamicResource [CtrlThm] Button_Secondary}"
								IsEnabled="{Binding HasGame}"
								Command="{Binding MakeShortcutCommand}"
								ToolTip.Tip="{Binding ShortcutHint}" ToolTip.ShowOnDisabled="True">
							<!-- The icon at the left edge, the label centred in the space it leaves. -->
							<Grid ColumnDefinitions="Auto,*">
								<Path Classes="pin label" Data="{StaticResource [Glyph] Monitor}" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
								<TextBlock Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,0,0,0" Text="{L 'SHORTCUT'}"/>
							</Grid>
						</Button>
					</StackPanel>

					<!-- The one thing this page cannot fix by itself: PD2 has patched since these
					     files were written, and the game reads them in preference to its own. -->
					<TextBlock TextWrapping="Wrap" FontSize="{StaticResource [Type] Body}" Margin="0,12,0,0"
							   Foreground="{DynamicResource [Text] Danger}"
							   IsVisible="{Binding IsStale}"
							   Text="{Binding StaleNote}"/>

					<!-- The online advice, once: dismissed for good with its cross, and the sidebar's dot
					     with it. The message strip's backing and frame. -->
					<Border Margin="0,12,0,0" Padding="10,6,6,6" Background="#CC000000"
							BorderThickness="1" BorderBrush="{DynamicResource [Brush] Frame - Golden Dim}"
							IsVisible="{Binding ShowsOnlineNotice}">
						<Grid ColumnDefinitions="*,Auto">
							<TextBlock Grid.Column="0" TextWrapping="Wrap" FontSize="{StaticResource [Type] Body}" VerticalAlignment="Center"
									   Foreground="{DynamicResource [Text] Warning}"
									   Text="{x:Static vm:VP_ViewModel_Experimental_L.OnlineNotice}"/>
							<Button Grid.Column="1" Classes="bareicon" Name="OnlineNotice_Dismiss"
									VerticalAlignment="Center" Margin="8,0,0,0"
									Command="{Binding DismissOnlineNoticeCommand}" ToolTip.Tip="{L 'Close'}">
								<Path Classes="pin" Data="{StaticResource [Glyph] Close}"/>
							</Button>
						</Grid>
					</Border>

				</StackPanel>
			</Border>

		</StackPanel>
	</ScrollViewer>

	<views:DropPanel DataContext="{Binding DropPanel}"/>
	</Panel>
</UserControl>
