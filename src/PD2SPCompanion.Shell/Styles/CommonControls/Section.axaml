<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<!--
	  The framed block a panel is divided into, and the small label at the top of one. Both
	  inventory pages had written the frame out identically; the map seed picker is the third
	  user, and three copies is where a component stops being a coincidence.
	-->
	<!-- The card (the Character page's cards everywhere): a soft black edge on grey,
	     the stone through it - no gold frame, which is kept for what art has to read against. -->
	<Style Selector="Border.section">
		<Setter Property="BorderBrush" Value="{DynamicResource [ABrush] Black - A50%}"/>
		<Setter Property="BorderThickness" Value="1.5"/>
		<Setter Property="CornerRadius" Value="8"/>
		<Setter Property="Background" Value="{DynamicResource [ABrush] R50 G50 B50 - A50%}"/>
	</Style>

	<!-- The small label at the top of a section. -->
	<Style Selector="TextBlock.fieldname">
		<Setter Property="Foreground" Value="{DynamicResource [Text] Body}"/>
		<Setter Property="FontSize" Value="{StaticResource [Type] Body}"/>
		<Setter Property="Margin" Value="0,0,8,0"/>
		<Setter Property="VerticalAlignment" Value="Center"/>
	</Style>
</Styles>
