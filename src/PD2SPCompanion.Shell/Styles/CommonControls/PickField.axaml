<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<!--
	  A button that opens a picker, dressed as a drop box (ComboBox.axaml, slots) - one shape wherever a
	  field opens a list (it was three - the Edit page's skill and affix fields,
	  Settings' collection field, and the drop boxes). Text left, the drop box's height and padding.

	      <Button Classes="pickfield" Command="{Binding OpenPickerCommand}">
	          <TextBlock Text="{Binding Chosen}"/>
	      </Button>

	  "tall" lets it grow with its content, for a field that lists several lines (an item's affixes).
	-->
	<Style Selector="Button.pickfield">
		<Setter Property="Height" Value="28"/>
		<Setter Property="Padding" Value="8,0"/>
		<Setter Property="VerticalAlignment" Value="Center"/>
		<Setter Property="HorizontalAlignment" Value="Stretch"/>
		<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
		<Setter Property="VerticalContentAlignment" Value="Center"/>
		<Setter Property="Background" Value="{DynamicResource [Brush] Field}"/>
		<Setter Property="BorderBrush" Value="{DynamicResource [Brush] Frame - Golden Dim}"/>
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="CornerRadius" Value="2"/>
		<Setter Property="Foreground" Value="{DynamicResource [Text] Body}"/>
		<Setter Property="FontSize" Value="{StaticResource [Type] Body}"/>
		<Setter Property="Cursor" Value="Hand"/>
	</Style>
	<Style Selector="Button.pickfield.tall">
		<Setter Property="Height" Value="NaN"/>
		<Setter Property="MinHeight" Value="28"/>
		<Setter Property="Padding" Value="8,5"/>
		<Setter Property="VerticalContentAlignment" Value="Top"/>
	</Style>
	<Style Selector="Button.pickfield /template/ ContentPresenter#PART_ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource [Brush] Field}"/>
		<Setter Property="BorderBrush" Value="{DynamicResource [Brush] Frame - Golden Dim}"/>
		<Setter Property="BorderThickness" Value="1"/>
	</Style>
	<!-- As a drop box under the pointer. Fluent's Button repaints its text on hover and press - black on
	     these panels - so the text colour is held here too. -->
	<Style Selector="Button.pickfield:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.pickfield:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.pickfield:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource [Brush] Hover Wash}"/>
		<Setter Property="BorderBrush" Value="{DynamicResource [UI] GradBrush - Frame - Golden#02}"/>
		<Setter Property="Foreground" Value="{DynamicResource [Text] Body}"/>
	</Style>
	<Style Selector="Button.pickfield TextBlock">
		<Setter Property="FontSize" Value="{StaticResource [Type] Body}"/>
		<Setter Property="Foreground" Value="{DynamicResource [Text] Body}"/>
	</Style>
</Styles>
