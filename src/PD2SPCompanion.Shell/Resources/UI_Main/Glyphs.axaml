<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="using:System">
	<!--
		Every icon inside a page or a popup, one shape for each meaning: all in-page icons are in the glyph set. The
		chrome - the sidebar, the bookmarks, the title bar - draws its own.

		One grid for all of them: a 12-unit box, the shape inside 1 to 11, drawn as round-ended strokes. A
		Path takes one with Classes="pin" and Data="{StaticResource [Glyph] Name}"; Glyph.axaml sets the one
		size (14px, a 1.6px stroke - see [Glyph] Stroke) for every pin, so a glyph never carries a width, a height or a stroke of its
		own. Drawn rather than fitted: a shape stretched to its box takes its stroke with it, and every glyph
		came out a different weight (measured).

		Room inside: at 14px a 2px stroke fills most of a small outline, so a mark drawn inside a shape keeps
		a clear unit from its walls or it merges into them - the folder's + and arrow, the triangle's !, the
		globe's lines and the coins' rims all did. A badge goes outside the outline, at its
		top right, the outline broken where it sits. Check a new glyph at real size before using it:
		python tests/ui/glyphsheet.py out.png draws every glyph as the app does, and enlarged.
	-->

	<!-- ==== the stroke ==================================================================================== -->
	<!-- In grid units, which Glyph.axaml scales: a glyph's 12 units are 14px, a small one's 10px. 1.6px at rest,
	     2 screen pixels exactly at 125% - lighter than the 2px the set began with (14% of the icon, about twice
	     the usual line-icon weight) and crisp where 2.5 screen pixels smeared. The
	     chrome's filled icons have no stroke and are untouched. -->
	<sys:Double x:Key="[Glyph] Stroke">1.3714</sys:Double>
	<!-- A small glyph (10px): 1.2px, the same share of its size. -->
	<sys:Double x:Key="[Glyph] Stroke Small">1.44</sys:Double>
	<!-- Heavier than at rest, for a button holding a question (the armed bin): 2px. -->
	<sys:Double x:Key="[Glyph] Stroke Armed">1.7143</sys:Double>

	<!-- ==== marks ======================================================================================= -->
	<!-- A cross: close, clear, cancel, remove from a list. -->
	<StreamGeometry x:Key="[Glyph] Close">M 2,2 L 10,10  M 10,2 L 2,10</StreamGeometry>
	<!-- A tick: on, done, confirm, accept. -->
	<StreamGeometry x:Key="[Glyph] Tick">M 1.5,6.5 L 4.5,9.5 L 10.5,2.5</StreamGeometry>
	<!-- A stepper's minus and plus. -->
	<StreamGeometry x:Key="[Glyph] Minus">M 1.5,6 L 10.5,6</StreamGeometry>
	<StreamGeometry x:Key="[Glyph] Plus">M 1.5,6 L 10.5,6  M 6,1.5 L 6,10.5</StreamGeometry>
	<!-- A warning: a ring and its mark (Alert.axaml) - a ring, as a triangle left the mark no room. -->
	<StreamGeometry x:Key="[Glyph] Alert">M 11,6 A 5,5 0 1 1 1,6 A 5,5 0 1 1 11,6 Z  M 6,3.3 L 6,6.4  M 6,8.7 L 6.01,8.7</StreamGeometry>
	<!-- A note: the same ring with an "i" - something to know, not a warning (the "!" stood for
	     both). The Alert turned over. -->
	<StreamGeometry x:Key="[Glyph] Info">M 11,6 A 5,5 0 1 1 1,6 A 5,5 0 1 1 11,6 Z  M 6,5.6 L 6,8.7  M 6,3.3 L 6.01,3.3</StreamGeometry>

	<!-- ==== direction =================================================================================== -->
	<!-- A fold's chevron, pointing down; Chevron.axaml turns it while the fold is shut. -->
	<StreamGeometry x:Key="[Glyph] Chevron">M 2,4 L 6,8 L 10,4</StreamGeometry>
	<!-- A page back and on. -->
	<StreamGeometry x:Key="[Glyph] Chevron left">M 8,2 L 4,6 L 8,10</StreamGeometry>
	<StreamGeometry x:Key="[Glyph] Chevron right">M 4,2 L 8,6 L 4,10</StreamGeometry>
	<StreamGeometry x:Key="[Glyph] Chevron up">M 2,8 L 6,4 L 10,8</StreamGeometry>
	<!-- Two chevrons: all of them, between the inventory's two panes (one chevron moves the picked). -->
	<StreamGeometry x:Key="[Glyph] Chevrons right">M 2,2 L 6,6 L 2,10  M 6,2 L 10,6 L 6,10</StreamGeometry>
	<StreamGeometry x:Key="[Glyph] Chevrons left">M 10,2 L 6,6 L 10,10  M 6,2 L 2,6 L 6,10</StreamGeometry>
	<StreamGeometry x:Key="[Glyph] Chevrons down">M 2,2 L 6,6 L 10,2  M 2,6 L 6,10 L 10,6</StreamGeometry>
	<StreamGeometry x:Key="[Glyph] Chevrons up">M 2,10 L 6,6 L 10,10  M 2,6 L 6,2 L 10,6</StreamGeometry>
	<!-- Up: a gem out of its socket, a folder up. -->
	<StreamGeometry x:Key="[Glyph] Arrow up">M 6,10.5 L 6,1.5  M 2.5,5 L 6,1.5 L 9.5,5</StreamGeometry>
	<!-- Down, and up with it: gold between the gold panel's rows - carried down to the shared stash, and back up. -->
	<StreamGeometry x:Key="[Glyph] Arrow down">M 6,1.5 L 6,10.5  M 2.5,7 L 6,10.5 L 9.5,7</StreamGeometry>
	<!-- Into the materials tab (the game's "Deposit materials" is an arrow icon whose tail curls): an arrow come in from
	     the left, its tail curling down into the tab - Deposit materials, and nothing else. -->
	<StreamGeometry x:Key="[Glyph] Deposit">M 1.5,3 L 4.5,3 A 3.5,3.5 0 0 1 8,6.5 L 8,10.5  M 5.5,8 L 8,10.5 L 10.5,8</StreamGeometry>
	<!-- Three dots: what a line of tools had no room for (OverflowRow). Each a stroke too short to be a line. -->
	<StreamGeometry x:Key="[Glyph] More">M 2.2,6 L 2.3,6  M 5.95,6 L 6.05,6  M 9.7,6 L 9.8,6</StreamGeometry>
	<!-- Back and forward over where a page has been, as Explorer's two arrows (the vault page's path line). -->
	<StreamGeometry x:Key="[Glyph] Arrow left">M 10.5,6 L 1.5,6  M 5,2.5 L 1.5,6 L 5,9.5</StreamGeometry>
	<StreamGeometry x:Key="[Glyph] Arrow right">M 1.5,6 L 10.5,6  M 7,2.5 L 10.5,6 L 7,9.5</StreamGeometry>
	<!-- Two of the up arrow side by side: every gem out of its sockets at once - the single one's arrow, twice (it was
	     Chevrons up, which says "to the first"
	     elsewhere). Narrow heads, a unit between them, so the two do not join at 14px (tests/ui/glyphsheet.py). -->
	<StreamGeometry x:Key="[Glyph] Arrows up">M 3.5,10.5 L 3.5,1.5  M 1.5,3.5 L 3.5,1.5 L 5.5,3.5  M 8.5,10.5 L 8.5,1.5  M 6.5,3.5 L 8.5,1.5 L 10.5,3.5</StreamGeometry>
	<!-- The two panes' contents, swapped side to side or top to bottom. -->
	<StreamGeometry x:Key="[Glyph] Swap across">M 1.5,4 L 10.5,4  M 8,1.5 L 10.5,4 L 8,6.5  M 10.5,8 L 1.5,8  M 4,5.5 L 1.5,8 L 4,10.5</StreamGeometry>
	<StreamGeometry x:Key="[Glyph] Swap down">M 4,10.5 L 4,1.5  M 1.5,4 L 4,1.5 L 6.5,4  M 8,1.5 L 8,10.5  M 5.5,8 L 8,10.5 L 10.5,8</StreamGeometry>
	<!-- Into a tray and out of it: a file in, a file out - Import and Export, and nothing else (one glyph, one act: it was also Store, a purse's gold to the vault and Load). -->
	<StreamGeometry x:Key="[Glyph] Download">M 6,1.5 L 6,7.5  M 3.5,5 L 6,7.5 L 8.5,5  M 1.5,8.5 L 1.5,10.5 L 10.5,10.5 L 10.5,8.5</StreamGeometry>
	<!-- Store all (the same vault icon, distinct from Store's
	     tray): the vault bookmark's chest (Material Design's treasure-chest) with Download's arrow going into its lid
	     - one: two crowded the chest at 14px ("Use single arrow") - and a clear gap cut around it where it meets the
	     chest - "otherwise they overlapped with each other become a block of colour". One filled shape
	     (Path.pin.filled), built with shapely: the chest minus the arrow grown by 1.2 units, plus the arrow stroked as
	     Path.pin strokes (1.3714 units, round). Checked at real size
	     with tests/ui/glyphsheet.py beside Download. It replaced Download all, two arrows into Download's tray, which
	     looked too much like Store beside it. -->
	<StreamGeometry x:Key="[Glyph] Store all">F0 M 6.00,6.09 L 6.18,6.06 L 6.34,5.99 L 6.48,5.88 L 8.68,3.68 L 8.79,3.54 L 8.86,3.38 L 8.89,3.20 L 8.86,3.02 L 8.79,2.86 L 8.68,2.72 L 8.54,2.61 L 8.38,2.54 L 8.20,2.51 L 8.02,2.54 L 7.86,2.61 L 7.72,2.72 L 6.69,3.74 L 6.69,0.60 L 6.66,0.42 L 6.59,0.26 L 6.48,0.12 L 6.34,0.01 L 6.18,-0.06 L 6.00,-0.09 L 5.82,-0.06 L 5.66,0.01 L 5.52,0.12 L 5.41,0.26 L 5.34,0.42 L 5.31,0.60 L 5.31,3.74 L 4.28,2.72 L 4.14,2.61 L 3.98,2.54 L 3.80,2.51 L 3.62,2.54 L 3.46,2.61 L 3.32,2.72 L 3.21,2.86 L 3.14,3.02 L 3.11,3.20 L 3.14,3.38 L 3.21,3.54 L 3.32,3.68 L 5.52,5.88 L 5.66,5.99 L 5.82,6.06 Z M 1.90,4.80 L 1.73,5.00 L 1.60,5.23 L 1.53,5.49 L 1.50,5.75 L 1.50,7.55 L 4.65,7.55 L 4.65,7.10 L 5.19,7.10 L 4.93,6.95 L 4.78,6.84 L 4.67,6.73 L 2.42,4.48 L 2.33,4.50 L 2.10,4.63 Z M 10.50,7.55 L 10.50,5.75 L 10.47,5.49 L 10.40,5.23 L 10.27,5.00 L 10.10,4.80 L 9.90,4.63 L 9.67,4.50 L 9.58,4.48 L 7.33,6.73 L 7.22,6.84 L 7.07,6.95 L 6.81,7.10 L 7.35,7.10 L 7.35,7.55 Z M 6.45,8.45 L 6.45,7.55 L 5.55,7.55 L 5.55,8.45 Z M 6.45,9.35 L 5.55,9.35 L 4.65,8.45 L 4.65,8.00 L 1.50,8.00 L 1.50,11.60 L 10.50,11.60 L 10.50,8.00 L 7.35,8.00 L 7.35,8.45 Z</StreamGeometry>
	<StreamGeometry x:Key="[Glyph] Upload">M 6,7.5 L 6,1.5  M 3.5,4 L 6,1.5 L 8.5,4  M 1.5,8.5 L 1.5,10.5 L 10.5,10.5 L 10.5,8.5</StreamGeometry>
	<!-- Out to somewhere else: a picker, a list, a page of its own. -->
	<StreamGeometry x:Key="[Glyph] Open">M 5,1.5 L 1.5,1.5 L 1.5,10.5 L 10.5,10.5 L 10.5,7  M 7,1.5 L 10.5,1.5 L 10.5,5  M 10.5,1.5 L 5.5,6.5</StreamGeometry>
	<!-- Into a closed box and out of it - the archive's box, with its handle: into the vault and out of it.
	     Store and Withdraw, and a purse's gold to the vault and back (they wore the
	     files' tray). Checked at real size beside Download and Upload (tests/ui/glyphsheet.py). -->
	<StreamGeometry x:Key="[Glyph] To vault">M 6,0.8 L 6,5  M 3.9,3 L 6,5.1 L 8.1,3  M 1.5,7 L 10.5,7 L 10.5,10.5 L 1.5,10.5 Z  M 4.8,8.75 L 7.2,8.75</StreamGeometry>
	<StreamGeometry x:Key="[Glyph] From vault">M 6,5.1 L 6,0.9  M 3.9,3 L 6,0.9 L 8.1,3  M 1.5,7 L 10.5,7 L 10.5,10.5 L 1.5,10.5 Z  M 4.8,8.75 L 7.2,8.75</StreamGeometry>
	<!-- Going in: open a character - Exit's other way round (Load wore the files' tray). -->
	<StreamGeometry x:Key="[Glyph] Enter">M 7,1.5 L 10.5,1.5 L 10.5,10.5 L 7,10.5  M 1.5,6 L 7.5,6  M 5,3.5 L 7.5,6 L 5,8.5</StreamGeometry>
	<!-- Leaving: close the character. -->
	<StreamGeometry x:Key="[Glyph] Exit">M 5,1.5 L 1.5,1.5 L 1.5,10.5 L 5,10.5  M 4.5,6 L 10.5,6  M 8,3.5 L 10.5,6 L 8,8.5</StreamGeometry>

	<!-- ==== time ======================================================================================== -->
	<!-- Back and forward a step: every going back (one undo everywhere). -->
	<StreamGeometry x:Key="[Glyph] Undo">M 4,1.5 L 1.5,4 L 4,6.5  M 1.5,4 L 7.5,4 A 3.25,3.25 0 0 1 7.5,10.5 L 3.5,10.5</StreamGeometry>
	<StreamGeometry x:Key="[Glyph] Redo">M 8,1.5 L 10.5,4 L 8,6.5  M 10.5,4 L 4.5,4 A 3.25,3.25 0 0 0 4.5,10.5 L 8.5,10.5</StreamGeometry>
	<!-- A clock turned back: history, every respec, a quest reverted. -->
	<StreamGeometry x:Key="[Glyph] History">M 2.4,3.4 A 4.5,4.5 0 1 1 1.5,6  M 1.2,1.4 L 2.4,3.4 L 4.6,3  M 6,3.5 L 6,6 L 7.8,7.3</StreamGeometry>
	<!-- An archive box, lid, body and handle: the backups - stored copies, not the history's clock beside
	     them on the strip (the same clock on both misled). -->
	<StreamGeometry x:Key="[Glyph] Archive">M 1,2 L 11,2 L 11,4.5 L 1,4.5 Z  M 2,4.5 L 2,10.5 L 10,10.5 L 10,4.5  M 4.5,6.75 L 7.5,6.75</StreamGeometry>
	<!-- A ring with a tick: a quest completed. -->
	<StreamGeometry x:Key="[Glyph] Task done">M 10.5,6 A 4.5,4.5 0 1 1 7.6,1.8  M 3.8,5.8 L 5.8,7.8 L 10.8,2.8</StreamGeometry>

	<!-- ==== things ====================================================================================== -->
	<!-- The bin: a lid with its handle, a body, and two lines. -->
	<StreamGeometry x:Key="[Glyph] Bin">M 1.5,3 L 10.5,3  M 4.5,3 L 4.5,1.5 L 7.5,1.5 L 7.5,3  M 2.5,3 L 3.2,10.5 L 8.8,10.5 L 9.5,3  M 5,5 L 5,8.5  M 7,5 L 7,8.5</StreamGeometry>
	<!-- A page's lines beside a narrow strip of them in small: the vault's map of a folder, in place of the scroll bar. -->
	<StreamGeometry x:Key="[Glyph] Minimap">M 1.5,2.5 L 5.5,2.5  M 1.5,5 L 5.5,5  M 1.5,7.5 L 4.5,7.5  M 1.5,10 L 5.5,10  M 7.5,1.5 L 10.5,1.5 L 10.5,10.5 L 7.5,10.5 Z  M 7.5,4 L 10.5,4  M 7.5,6.5 L 10.5,6.5</StreamGeometry>
	<!-- A pencil: rename. -->
	<StreamGeometry x:Key="[Glyph] Pencil">M 1.5,10.5 L 2,8 L 8.5,1.5 L 10.5,3.5 L 4,10 Z  M 7,3 L 9,5</StreamGeometry>
	<!-- The magnifier: search. -->
	<StreamGeometry x:Key="[Glyph] Magnifier">M 8.5,5 A 3.5,3.5 0 1 1 1.5,5 A 3.5,3.5 0 1 1 8.5,5  M 7.5,7.5 L 10.5,10.5</StreamGeometry>
	<!-- Two links of a chain: a property row's number put on the rows written with it: a button that
	     propagates the current box's value to the other synced boxes. -->
	<StreamGeometry x:Key="[Glyph] Link">M 6.5,3.5 L 7.5,2.5 A 2.12,2.12 0 0 1 10.5,5.5 L 9.5,6.5  M 5.5,8.5 L 4.5,9.5 A 2.12,2.12 0 0 1 1.5,6.5 L 2.5,5.5  M 4.5,7.5 L 7.5,4.5</StreamGeometry>
	<!-- Two squares, one over the other: duplicate, clone. -->
	<StreamGeometry x:Key="[Glyph] Duplicate">M 1.5,4.5 L 7.5,4.5 L 7.5,10.5 L 1.5,10.5 Z  M 4.5,4.5 L 4.5,1.5 L 10.5,1.5 L 10.5,7.5 L 7.5,7.5</StreamGeometry>
	<!-- Paste: a clipboard, its clip at the top - the Forge's Paste from game (Material Design's
	     content-paste, drawn in this set's strokes). The clip is a box two and a half units deep, so its opening
	     still shows at 14px; shallower, it filled in (tests/ui/glyphsheet.py). -->
	<StreamGeometry x:Key="[Glyph] Paste">M 4,2.5 L 2,2.5 L 2,10.5 L 10,10.5 L 10,2.5 L 8,2.5  M 4,1.5 L 8,1.5 L 8,4 L 4,4 Z</StreamGeometry>
	<!-- Sort: an arrow up and an arrow down - the Sort button's own drawing (SortMenu's default glyph, which is
	     written out there as a control's default cannot be looked up), here for the menu's "Sort by" row. -->
	<StreamGeometry x:Key="[Glyph] Sort">M 3.5,11 L 3.5,1.5  M 1,4 L 3.5,1.5 L 6,4  M 8.5,1 L 8.5,10.5  M 6,8 L 8.5,10.5 L 11,8</StreamGeometry>
	<!-- Cut: a pair of scissors, its two rings at the foot and its blades crossing to the top (the clipboard's three, as
	     Windows' menu has them). Copy is Duplicate's two squares. -->
	<StreamGeometry x:Key="[Glyph] Cut">M 4.9,9 A 1.7,1.7 0 1 1 1.5,9 A 1.7,1.7 0 1 1 4.9,9 Z  M 10.5,9 A 1.7,1.7 0 1 1 7.1,9 A 1.7,1.7 0 1 1 10.5,9 Z  M 4.3,7.7 L 9.5,1.5  M 7.7,7.7 L 2.5,1.5</StreamGeometry>
	<!-- Select all: corner marks round a square - the picks menu (all, none, the other way round). Corners,
	     not a dashed frame: at 14px the dashes ran together. -->
	<StreamGeometry x:Key="[Glyph] Select all">M 1,3.5 L 1,1 L 3.5,1  M 8.5,1 L 11,1 L 11,3.5  M 11,8.5 L 11,11 L 8.5,11  M 3.5,11 L 1,11 L 1,8.5  M 4,4 L 8,4 L 8,8 L 4,8 Z</StreamGeometry>
	<!-- A socket: a ring round a gem - the sockets drawn over the tiles. -->
	<StreamGeometry x:Key="[Glyph] Socket">M 10.5,6 A 4.5,4.5 0 1 1 1.5,6 A 4.5,4.5 0 1 1 10.5,6 Z  M 7.5,6 A 1.5,1.5 0 1 1 4.5,6 A 1.5,1.5 0 1 1 7.5,6 Z</StreamGeometry>
	<!-- A buckle and the strap either side: the belt. Drawn open - a strap closed round the buckle filled in
	     at this size. -->
	<StreamGeometry x:Key="[Glyph] Belt">M 1,4.5 L 4,4.5  M 8,4.5 L 11,4.5  M 1,7.5 L 4,7.5  M 8,7.5 L 11,7.5  M 4,2.5 L 8,2.5 L 8,9.5 L 4,9.5 Z</StreamGeometry>
	<!-- A floppy: save, apply. -->
	<StreamGeometry x:Key="[Glyph] Save">M 1.5,1.5 L 8.5,1.5 L 10.5,3.5 L 10.5,10.5 L 1.5,10.5 Z  M 3.5,1.5 L 3.5,4 L 7.5,4 L 7.5,1.5  M 3.5,10.5 L 3.5,7 L 8.5,7 L 8.5,10.5</StreamGeometry>
	<!-- A star: quick access - a folder pinned to the list over the vault's tree. -->
	<StreamGeometry x:Key="[Glyph] Star">M 6,1.2 L 7.5,4.3 L 10.9,4.8 L 8.4,7.1 L 9,10.5 L 6,8.9 L 3,10.5 L 3.6,7.1 L 1.1,4.8 L 4.5,4.3 Z</StreamGeometry>
	<!-- A ribbon: keep (a seed, a preset). -->
	<StreamGeometry x:Key="[Glyph] Bookmark">M 2.5,1.5 L 9.5,1.5 L 9.5,10.5 L 6,8 L 2.5,10.5 Z</StreamGeometry>
	<!-- Three bars: statistics. -->
	<StreamGeometry x:Key="[Glyph] Statistics">M 1,10.5 L 11,10.5  M 3,10 L 3,6.5  M 6,10 L 6,2  M 9,10 L 9,4.5</StreamGeometry>
	<!-- Three bars and a rise: meet the gear's requirements. -->
	<StreamGeometry x:Key="[Glyph] Refit">M 2,10.5 L 2,6.5  M 6,10.5 L 6,3  M 10,10.5 L 10,5  M 4.3,3.7 L 6,2 L 7.7,3.7</StreamGeometry>
	<!-- A cup with handles: the grail. -->
	<StreamGeometry x:Key="[Glyph] Grail">M 3,1.5 L 9,1.5 L 9,4.5 A 3,3 0 0 1 3,4.5 Z  M 3,2.5 L 1.5,2.5 L 1.5,3.5 A 1.5,1.5 0 0 0 3,5  M 9,2.5 L 10.5,2.5 L 10.5,3.5 A 1.5,1.5 0 0 1 9,5  M 6,7.5 L 6,9.5  M 3.5,10.5 L 8.5,10.5</StreamGeometry>
	<!-- A dollar sign: prices, buying, selling (preferred to coins). Its stroke stops
	     above and below the S - run through it, the S filled in at 14px. -->
	<StreamGeometry x:Key="[Glyph] Dollar">M 8.6,3.7 C 8.2,2.8 7.2,2.3 6,2.3 C 4.5,2.3 3.4,3.1 3.4,4.2 C 3.4,5.4 4.6,5.8 6,6.1 C 7.5,6.4 8.6,6.9 8.6,8 C 8.6,9.2 7.5,9.8 6,9.8 C 4.7,9.8 3.7,9.3 3.3,8.4  M 6,0.8 L 6,2.3  M 6,9.8 L 6,11.2</StreamGeometry>
	<!-- Three lines, each after its dot: a list of records - the trades. Not the
	     history's clock, which is the session's undo, nor the archive's box, which is the backups. -->
	<StreamGeometry x:Key="[Glyph] List">M 1.6,2.6 L 2.4,2.6  M 4.4,2.6 L 10.6,2.6  M 1.6,6 L 2.4,6  M 4.4,6 L 10.6,6  M 1.6,9.4 L 2.4,9.4  M 4.4,9.4 L 10.6,9.4</StreamGeometry>
	<!-- A globe: a site on the web. -->
	<StreamGeometry x:Key="[Glyph] Globe">M 10.75,6 A 4.75,4.75 0 1 1 1.25,6 A 4.75,4.75 0 1 1 10.75,6 Z  M 6,1.25 A 2.1,4.75 0 0 1 6,10.75 A 2.1,4.75 0 0 1 6,1.25 Z  M 1.25,6 L 10.75,6</StreamGeometry>
	<!-- A screen: a desktop shortcut. -->
	<StreamGeometry x:Key="[Glyph] Monitor">M 1.5,1.5 L 10.5,1.5 L 10.5,8 L 1.5,8 Z  M 6,8 L 6,10.5  M 3.5,10.5 L 8.5,10.5</StreamGeometry>
	<!-- A figure and a plus: make a character. -->
	<StreamGeometry x:Key="[Glyph] Person plus">M 6,3.5 A 2,2 0 1 1 2,3.5 A 2,2 0 1 1 6,3.5 Z  M 0.5,10.5 C 0.5,7.2 7.5,7.2 7.5,10.5  M 9.5,3 L 9.5,7  M 7.5,5 L 11.5,5</StreamGeometry>
	<!-- A cross of mercy: revive a dead hardcore character. -->
	<StreamGeometry x:Key="[Glyph] Revive">M 4.5,1.5 L 7.5,1.5 L 7.5,4.5 L 10.5,4.5 L 10.5,7.5 L 7.5,7.5 L 7.5,10.5 L 4.5,10.5 L 4.5,7.5 L 1.5,7.5 L 1.5,4.5 L 4.5,4.5 Z</StreamGeometry>
	<!-- A brush: clean an item back to a white base. No bristle lines - at 14px they filled the head. -->
	<StreamGeometry x:Key="[Glyph] Clean">M 9.5,1.5 L 6,6.5  M 2.5,6.5 L 8.5,6.5 L 7.5,10.5 L 1.5,10.5 Z</StreamGeometry>
	<!-- A ghost: ethereal. -->
	<StreamGeometry x:Key="[Glyph] Ghost">M 2.5,10.5 L 2.5,5.5 A 3.5,3.5 0 0 1 9.5,5.5 L 9.5,10.5 L 8.3,9.5 L 7.2,10.5 L 6,9.5 L 4.8,10.5 L 3.7,9.5 Z  M 4.75,5.5 L 4.8,5.5  M 7.25,5.5 L 7.3,5.5</StreamGeometry>
	<!-- A golem: the Iron Golem's item, beside the mercenary. "Rock golem" by Delapouite, game-icons.net, CC BY 3.0
	     (THIRD-PARTY-NOTICES.md), the path as published on its 512-unit grid - worn with Classes="pin art" (the game's
	     own skill icon carries the bevel of the button it is cut from, and the
