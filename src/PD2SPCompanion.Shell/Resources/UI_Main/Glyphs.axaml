	<!-- A padlock, shut and open: the inventory lock. Open swings the shackle off its left post, so the two
	     differ at a glance rather than by a gap a stroke wide. -->
	<StreamGeometry x:Key="[Glyph] Lock">M 3,5 L 9,5 A 1,1 0 0 1 10,6 L 10,9.5 A 1,1 0 0 1 9,10.5 L 3,10.5 A 1,1 0 0 1 2,9.5 L 2,6 A 1,1 0 0 1 3,5 Z  M 4,5 L 4,3.5 A 2,2 0 0 1 8,3.5 L 8,5  M 6,7.2 L 6,8.3</StreamGeometry>
	<StreamGeometry x:Key="[Glyph] Unlock">M 3,5 L 9,5 A 1,1 0 0 1 10,6 L 10,9.5 A 1,1 0 0 1 9,10.5 L 3,10.5 A 1,1 0 0 1 2,9.5 L 2,6 A 1,1 0 0 1 3,5 Z  M 6,7.2 L 6,8.3  M 8,5 L 8,2.6 A 2,2 0 0 1 12,2.6</StreamGeometry>
	<!-- The socket's ring with a padlock in it - shut, and open: socketing by a drop held off, or not (after Material's
	     "Lock Open Circle"). Checked at real size (tests/ui/glyphsheet.py): the two
	     differ by the shackle's free end, and the button's lit state says the rest. -->
	<StreamGeometry x:Key="[Glyph] Socket lock">M 11,6 A 5,5 0 1 1 1,6 A 5,5 0 1 1 11,6 Z  M 4.2,6.3 L 7.8,6.3 L 7.8,8 L 4.2,8 Z  M 4.9,6.3 L 4.9,4.9 A 1.1,1.1 0 0 1 7.1,4.9 L 7.1,6.3</StreamGeometry>
	<StreamGeometry x:Key="[Glyph] Socket unlock">M 11,6 A 5,5 0 1 1 1,6 A 5,5 0 1 1 11,6 Z  M 4.2,6.9 L 7.8,6.9 L 7.8,8.4 L 4.2,8.4 Z  M 4.9,6.9 L 4.9,4.3 A 1.1,1.1 0 0 1 7.1,4.3</StreamGeometry>
	<!-- The way back out of a layer: the jewel's panel to the item that holds it. -->
	<StreamGeometry x:Key="[Glyph] Back">M 7.5,2 L 3.5,6 L 7.5,10</StreamGeometry>

	<!-- ==== folders ===================================================================================== -->
	<StreamGeometry x:Key="[Glyph] Folder">M 1,2.5 L 4.5,2.5 L 5.5,4 L 11,4 L 11,10 L 1,10 Z</StreamGeometry>
	<!-- An open folder: open a backup, a collection, a game folder. -->
